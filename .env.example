# Copia este archivo como .env en la raíz del proyecto y completa los valores reales.
# .env nunca se sube al repositorio (ver .gitignore).

# --- Backend (Django) ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-real
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# localhost:5173 es donde corre "npm run dev" (Vite); localhost:8100 es el que usa "ionic serve".
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8100

# --- Base de datos (PostgreSQL) ---
DB_NAME=love_lsc
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Firebase (autenticación y notificaciones, configuración del frontend) ---
# Prefijo VITE_ obligatorio: es lo único que Vite expone al código del navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase Admin SDK (backend, para verificar el ID token de cada request) ---
# Ruta local al archivo JSON de la cuenta de servicio descargado desde
# Firebase Console > Configuración del proyecto > Cuentas de servicio.
# Ese archivo NUNCA se sube al repositorio.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# --- Frontend (Ionic + React) ---
# URL del backend que consume el frontend en desarrollo local.
VITE_API_BASE_URL=http://localhost:8001
