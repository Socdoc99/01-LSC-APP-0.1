# Copia este archivo como .env en la raíz del proyecto y completa los valores reales.
# .env nunca se sube al repositorio (ver .gitignore).

# --- Backend (Django) ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-real
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# localhost:5173 es donde corre "npm run dev" (Vite); localhost:8100 es el que usa "ionic serve".
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8100
# Solo hace falta en producción (Render): dominios desde los que se acepta
# el admin de Django con CSRF, ej: https://love-lsc-backend.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Base de datos (PostgreSQL) ---
DB_NAME=love_lsc
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# En local, vacío. En producción con Supabase (u otro Postgres gestionado):
# require
DB_SSLMODE=

# --- Firebase (autenticación, configuración del frontend) ---
# Prefijo VITE_ obligatorio: es lo único que Vite expone al código del navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Solo para desarrollo local con el Firebase Auth Emulator (npx firebase-tools
# emulators:start --only auth). Déjala vacía para conectar con Firebase real.
VITE_FIREBASE_AUTH_EMULATOR_HOST=

# --- Firebase Admin SDK (backend, para verificar el ID token de cada request) ---
FIREBASE_PROJECT_ID=
# Desarrollo local en tu máquina: ruta al archivo JSON de la cuenta de
# servicio descargado desde Firebase Console > Configuración del proyecto >
# Cuentas de servicio. Ese archivo NUNCA se sube al repositorio.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
# Producción en hosting sin sistema de archivos propio (Render, etc.): pega
# el CONTENIDO completo de ese mismo JSON aquí en vez de una ruta.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Solo para desarrollo local con el Firebase Auth Emulator. Si se define, el
# backend se conecta al emulador en vez de pedir cualquiera de las dos
# credenciales de arriba.
FIREBASE_AUTH_EMULATOR_HOST=

# --- Frontend (Ionic + React) ---
# URL del backend. En local, el puerto donde corre Django (manage.py runserver;
# en esta configuración, 8001 porque 8000 ya estaba ocupado por otro proceso).
# En producción, la URL que asigna Render, ej: https://love-lsc-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8001
