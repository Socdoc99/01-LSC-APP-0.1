# Copia este archivo como .env en la raíz del proyecto y completa los valores reales.
# .env nunca se sube al repositorio (ver .gitignore).

# --- Backend (Django) ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-real
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8100

# --- Base de datos (PostgreSQL) ---
DB_NAME=love_lsc
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Firebase (autenticación y notificaciones) ---
# Se completa cuando se integre Firebase en la Fase 1 / Fase 3.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Frontend (Ionic + React) ---
# URL del backend que consume el frontend en desarrollo local.
VITE_API_BASE_URL=http://localhost:8000
