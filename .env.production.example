# Vite necesita estas variables al momento de compilar (no en tiempo de
# ejecución), así que van en un archivo aparte del .env de desarrollo.
#
# Copia este archivo como .env.production en la raíz del proyecto, completa
# los valores reales, y luego: cd frontend && npm run build && firebase deploy --only hosting
#
# .env.production nunca se sube al repositorio (ver .gitignore).

# Del proyecto de Firebase REAL (no del emulador): Firebase Console >
# Configuración del proyecto > Tus apps > app web > Config del SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Vacío: en producción NO se usa el emulador, se conecta a Firebase real.
VITE_FIREBASE_AUTH_EMULATOR_HOST=

# URL del backend ya desplegado en Render, ej: https://love-lsc-backend.onrender.com
VITE_API_BASE_URL=
